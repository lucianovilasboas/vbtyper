# Copie para `.env` e ajuste conforme necessário. Nada de segredos aqui:
# a chave da OpenAI vive no cofre do sistema (`vb-typer-api --setup`).

# Rede
VB_TYPER_HOST=127.0.0.1
VB_TYPER_PORT=8765
VB_TYPER_LOG_LEVEL=INFO

# Diretórios (vazio = padrões do sistema via platformdirs)
# VB_TYPER_DATA_DIR=
# VB_TYPER_CONFIG_DIR=
# VB_TYPER_DATABASE_PATH=

# Segurança
# VB_TYPER_API_TOKEN=
# VB_TYPER_ALLOWED_HOSTS=127.0.0.1,localhost
# VB_TYPER_CORS_ORIGINS=http://127.0.0.1:8765

# OpenAI
VB_TYPER_OPENAI_BASE_URL=https://api.openai.com/v1
VB_TYPER_OPENAI_TIMEOUT_S=120

# Áudio
VB_TYPER_MAX_UPLOAD_BYTES=26214400
VB_TYPER_DEFAULT_MODEL=gpt-4o-mini-transcribe
VB_TYPER_DEFAULT_LANGUAGE=pt
VB_TYPER_KEEP_AUDIO=true
VB_TYPER_WEEK_START=monday
VB_TYPER_WORKER_CONCURRENCY=2
