# VB Typer 2.0 — variáveis do contêiner.
#
# Copie para .env e preencha:
#     cp .env.example .env
#
# O .env NÃO vai para o repositório (já está no .gitignore) e carrega segredos.

# --- Credenciais (obrigatórias) ---------------------------------------------

# Chave da OpenAI. No contêiner não existe cofre do sistema, então a chave vem
# daqui — o ambiente tem precedência sobre o cofre (por isso `--setup` não se
# aplica na imagem).
OPENAI_API_KEY=

# Token da API. Gere um novo com:  openssl rand -hex 32
# É o valor que o cliente desktop guarda em ~/.config/vb-typer/api-token.
VB_TYPER_API_TOKEN=

# --- Acesso pela rede ZeroTier ---------------------------------------------

# Endereço da interface ZeroTier NO HOST onde a porta será publicada.
# Descubra com:  ip -4 -brief addr show      (interface zt...)
# Deixe 127.0.0.1 para acessar só do próprio host (ex.: por túnel SSH).
# NUNCA use 0.0.0.0 enquanto não houver login.
VB_TYPER_BIND_ADDR=127.0.0.1
VB_TYPER_BIND_PORT=8765

# Hosts aceitos, SEM porta. Inclua o endereço usado no navegador e no cliente.
# Loopback (127.0.0.1, localhost, ::1) já é aceito automaticamente.
VB_TYPER_ALLOWED_HOSTS=127.0.0.1,localhost

# Origem aceita em requisições de NAVEGADOR (o webapp manda Origin no POST).
# Precisa casar exatamente com o endereço usado no navegador, senão a API
# responde 403 invalid_origin. Ex.: http://10.147.20.5:8765
VB_TYPER_CORS_ORIGINS=

# --- Ajustes opcionais ------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR
VB_TYPER_LOG_LEVEL=INFO

# Padrões de ditado (o cliente pode sobrepor a cada job).
# VB_TYPER_DEFAULT_MODEL=gpt-4o-mini-transcribe
# VB_TYPER_DEFAULT_LANGUAGE=pt

# Modelos autorizados (lista separada por vírgula).
# VB_TYPER_ALLOWED_MODELS=gpt-4o-mini-transcribe,gpt-transcribe

# Limites de entrada.
# VB_TYPER_MAX_UPLOAD_BYTES=26214400
# VB_TYPER_MAX_AUDIO_SECONDS=120
