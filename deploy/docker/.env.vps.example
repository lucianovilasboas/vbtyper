# VB Typer 2.0 — variáveis da VPS (Traefik compartilhado).
#
#     cp .env.vps.example .env
#
# O .env fica só na VPS: ele NÃO vai para o repositório.

# --- Domínio e proteção de acesso -------------------------------------------

# Host público (o Traefik emite o certificado para ele).
VB_TYPER_DOMAIN=vbtyper.lucianovilasboas.com.br

# Basic Auth da interface (o Traefik consome esta label).
# Gere o hash — NUNCA coloque a senha aqui:
#     openssl passwd -apr1
# e cole no formato  usuario:hash
#
# O `$` do hash é interpretado pelo compose: escape com `$$`.
# Exemplo (senha fictícia):
# VB_TYPER_BASIC_AUTH=luciano:$$apr1$$XsaltX$$hashhashhashhashhashhash
VB_TYPER_BASIC_AUTH=

# --- Credenciais (obrigatórias) ---------------------------------------------

# Chave da OpenAI. No contêiner não há cofre: o ambiente tem precedência.
OPENAI_API_KEY=

# Token da API (o mesmo que o desktop guarda). Gere com:
#     openssl rand -hex 32
VB_TYPER_API_TOKEN=

# --- Acesso e segurança ------------------------------------------------------

# Hosts aceitos, SEM porta. O domínio precisa estar aqui, senão a API responde
# 400 antes de qualquer rota.
VB_TYPER_ALLOWED_HOSTS=vbtyper.lucianovilasboas.com.br,127.0.0.1,localhost

# Origem aceita em requisições de navegador (o webapp manda Origin no POST).
# Sem ela, a página abre mas o ditado leva 403 invalid_origin.
VB_TYPER_CORS_ORIGINS=https://vbtyper.lucianovilasboas.com.br

# Atrás do Traefik (TLS), o cookie de sessão deve ser Secure.
VB_TYPER_COOKIE_SECURE=true

# --- Opcionais ---------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR
VB_TYPER_LOG_LEVEL=INFO

# VB_TYPER_DEFAULT_MODEL=gpt-4o-mini-transcribe
# VB_TYPER_DEFAULT_LANGUAGE=pt
# VB_TYPER_MAX_UPLOAD_BYTES=26214400
# VB_TYPER_MAX_AUDIO_SECONDS=120
